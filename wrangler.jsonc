{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyfarm",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/", "/api/*", "/film-script", "/login", "/buyer", "/grower"] },
  "durable_objects": { "bindings": [{ "name": "MARKETPLACE", "class_name": "Marketplace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Marketplace"] }],
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
