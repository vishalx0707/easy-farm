{
  "name": "easyfarm-preview",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build": "node tools/build.cjs",
    "dev:cloudflare": "node tools/dev-secret.cjs && npm run build && wrangler dev --port 8787 --persist-to .wrangler/local",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "node tools/verify.cjs",
    "test:auth": "node tools/verify-clerk.cjs",
    "test:worker": "npm run build && wrangler deploy --dry-run --outdir .wrangler/test-bundle && node tools/verify-worker.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clerk/backend": "^3.33.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "miniflare": "^5.20261123.1-beta",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "wrangler": "^4.168.0"
  }
}
